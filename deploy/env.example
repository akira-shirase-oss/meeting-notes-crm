# The server's environment: one KEY=value per line, comments on their own lines only
# (systemd's EnvironmentFile keeps `KEY=value # note` as part of the value). Install it as
# /etc/meetcrm/env, root-owned, mode 0644: it holds no secret. Every variable is checked at
# startup; one out of bounds stops the server with every problem listed.
#
# Each line shows the default. A test (crates/meetcrm-server/src/config.rs) keeps this
# file and the code in step: a variable added there must be added here.

# --- Listening and connection bounds (crates/meetcrm-http/src/serve.rs) ---------------
# Loopback only: Caddy terminates TLS in front (deploy/Caddyfile).
# MEETCRM_LISTEN=127.0.0.1:63650
# A request head must arrive within this; also the idle timeout of keep-alive connections.
# MEETCRM_HEADER_READ_TIMEOUT_MS=10000
# Connections served at once; past it they wait in the listen backlog. Keep it below the
# unit's LimitNOFILE (deploy/meetcrm.service) less the pool and some headroom.
# MEETCRM_MAX_CONNECTIONS=512
# A response write that makes no progress for this long closes its connection.
# MEETCRM_WRITE_STALL_MS=10000
# The answer to this many requests on one connection says Connection: close.
# MEETCRM_MAX_REQUESTS_PER_CONNECTION=1000
# A connection older than this finishes its request in flight and closes.
# MEETCRM_CONNECTION_MAX_AGE_MS=600000
# How long an aged connection may take to finish (at least the request timeout).
# MEETCRM_REQUEST_GRACE_MS=10000
# How long shutdown waits for open connections; keep it below TimeoutStopSec.
# MEETCRM_DRAIN_TIMEOUT_MS=15000

# --- Requests (crates/meetcrm-http/src/stack.rs) --------------------------------------
# The whole request, body included; past it 503.
# MEETCRM_REQUEST_TIMEOUT_MS=5000
# MEETCRM_MAX_BODY_BYTES=65536
# /v1 requests running at once; past it 503 overloaded at once.
# MEETCRM_MAX_IN_FLIGHT=64

# --- Database (crates/meetcrm-db) ------------------------------------------------------
# MEETCRM_DB_MAX_CONNECTIONS=16
# MEETCRM_DB_ACQUIRE_TIMEOUT_MS=2000
# MEETCRM_DB_STATEMENT_TIMEOUT_MS=3000
# The /readyz probe's deadline.
# MEETCRM_READY_TIMEOUT_MS=500
# How long startup waits for an unavailable database before giving up.
# MEETCRM_STARTUP_TIMEOUT_MS=30000

# --- Health and logs -------------------------------------------------------------------
# /errorz answers 503 when server errors exceed this many per thousand requests over five
# minutes, once at least MEETCRM_ERROR_MIN_REQUESTS were answered.
# MEETCRM_ERROR_RATE_PERMILLE=50
# MEETCRM_ERROR_MIN_REQUESTS=20
# MEETCRM_LOG=info
# json for journald; text for a terminal.
# MEETCRM_LOG_FORMAT=json

# --- Accounts (crates/meetcrm-accounts) ------------------------------------------------
# A loopback SMTP relay (the local MTA that relays onward over TLS). Empty disables mail.
# MEETCRM_SMTP_RELAY=
# MEETCRM_MAIL_FROM=noreply@meeting-notes-crm.invalid
# Where links in emails point.
# MEETCRM_PUBLIC_URL=http://127.0.0.1:63650
# MEETCRM_COOKIE_SECURE=true
# MEETCRM_SESSION_TTL_S=604800
# MEETCRM_SESSION_IDLE_S=86400
# Caddy on this host is 127.0.0.1: then budgets key on the client, not on Caddy.
# MEETCRM_TRUSTED_PROXIES=
# MEETCRM_PASSWORD_CONCURRENCY=2
# The free plan's limits (payments are bypassed).
# MEETCRM_PLAN_MAX_MEMBERS=10
# MEETCRM_PLAN_MAX_TOKENS=10
# MEETCRM_PLAN_MAX_OWNED_WORKSPACES=3

# --- Secrets: never in this file ------------------------------------------------------
# The unit loads them as systemd credentials (LoadCredential=, files under
# /etc/meetcrm/credentials, root:root 0600); the server reads $CREDENTIALS_DIRECTORY/<name>.
# Outside systemd, point a _FILE variable at an owner-only file instead:
#   database-url            the server, as the runtime role meetcrm_app
#   migration-database-url  meetcrmctl migrate, digests, fingerprint, prune-events (meetcrm_owner)
#   admin-database-url      meetcrmctl bootstrap only
#   owner-password          meetcrmctl bootstrap only
#   app-password            meetcrmctl bootstrap only
# MEETCRM_DATABASE_URL_FILE=/etc/meetcrm/credentials/database-url
# MEETCRM_MIGRATION_DATABASE_URL_FILE=/etc/meetcrm/credentials/migration-database-url
# MEETCRM_ADMIN_DATABASE_URL_FILE=/etc/meetcrm/credentials/admin-database-url
# MEETCRM_OWNER_PASSWORD_FILE=/etc/meetcrm/credentials/owner-password
# MEETCRM_APP_PASSWORD_FILE=/etc/meetcrm/credentials/app-password
